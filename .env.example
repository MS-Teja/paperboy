# Ring — Playground mode (token lasts ~30 min). Set this OR the refresh-token trio, never both.
RING_ACCESS_TOKEN=
# Ring — refresh-token mode (optional)
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_REFRESH_TOKEN=
RING_HMAC_KEY=

# AWS
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
SNS_FAMILY_TOPIC_ARN=

# Telegram
TELEGRAM_BOT_TOKEN=

# App
DATABASE_PATH=./data/app.db
FAKE_NOW=
FAMILY_PASSCODE=

# Demo: the Telegram chat that stands in for the parent (the builder's own account)
DEMO_PARENT_TELEGRAM_CHAT_ID=
